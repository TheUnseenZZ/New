# Local development: a SQLite file (created automatically by `npm run dev`).
# Production: a Postgres URL (e.g. from Neon) — the app switches automatically.
DATABASE_URL="file:./dev.db"

# Password for the builder dashboard (single admin).
ADMIN_PASSWORD="change-me"

# Random string (32+ chars) used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"
