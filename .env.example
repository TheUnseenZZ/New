# SQLite file for local development. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# Password for the builder dashboard (single admin).
ADMIN_PASSWORD="change-me"

# Random string (32+ chars) used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"
