{
  "id": "diary",
  "name": "Diary",
  "vibe": "Handwritten lowercase that writes itself on, slightly crooked",
  "tags": ["aesthetic", "handwritten", "acoustic"],
  "font": { "family": "Caveat", "weight": 700, "size": 108, "lineHeight": 1.05, "case": "lower" },
  "color": {
    "fill": "#FFFFFF",
    "shadow": { "color": "rgba(0,0,0,0.5)", "blur": 12, "x": 0, "y": 3 }
  },
  "layout": { "mode": "line", "anchor": "lower", "maxWidth": 0.88 },
  "reveal": "char",
  "enter": { "anim": "fade", "duration": 120 },
  "exit": { "anim": "fade", "duration": 300 },
  "timing": { "hold": 1.0 },
  "fx": { "tilt": 3, "wobble": 1.2 }
}
