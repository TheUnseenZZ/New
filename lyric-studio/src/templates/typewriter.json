{
  "id": "typewriter",
  "name": "Typewriter",
  "vibe": "Grungy typewriter letters typed onto darkened, grainy footage",
  "tags": ["grunge", "storytelling"],
  "font": { "family": "Special Elite", "weight": 400, "size": 70, "lineHeight": 1.3, "case": "none" },
  "color": {
    "fill": "#F2F2F2",
    "shadow": { "color": "rgba(0,0,0,0.6)", "blur": 6, "x": 2, "y": 2 }
  },
  "layout": { "mode": "line", "anchor": "center", "align": "left", "maxWidth": 0.9 },
  "reveal": "char",
  "enter": { "anim": "none", "duration": 1 },
  "exit": { "anim": "fade", "duration": 250 },
  "timing": { "lead": 0, "hold": 1.2 },
  "fx": { "flicker": 0.03 },
  "frame": { "dim": 0.25, "grain": 0.2, "vignette": 0.5 }
}
